<?xml version="1.0" encoding="utf-8"?>
<!-- The themed-icon layer, for Android 13 and later. The system throws away
     these colours and tints the whole silhouette with one of the wallpaper's,
     so the only thing that matters here is the shape: black at full opacity
     everywhere, or the tint comes out patchy where the alpha was.

     Same geometry and same 108dp canvas as ic_launcher_foreground. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="2.1875"
        android:scaleY="2.1875"
        android:translateX="19"
        android:translateY="19">

        <path
            android:pathData="M3,16 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0"
            android:strokeColor="#000000"
            android:strokeWidth="1.8" />

        <path
            android:pathData="M20.3,8.55 A8.6,8.6 0 1 1 11.7,8.55"
            android:strokeColor="#000000"
            android:strokeWidth="2.2" />

        <path
            android:pathData="M12.2,16 a3.8,3.8 0 1,0 7.6,0 a3.8,3.8 0 1,0 -7.6,0"
            android:fillColor="#000000" />

        <path
            android:pathData="M13.6,3 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0"
            android:fillColor="#000000" />
    </group>
</vector>
