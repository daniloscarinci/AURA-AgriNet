<?xml version="1.0" encoding="utf-8"?>
<!-- The brand mark, drawn as vector rather than scaled from a PNG so it stays
     sharp at every launcher density.

     Geometry comes from MARK in icons/build-icons.js, expressed in that file's
     32-unit viewport and then scaled into the 108dp adaptive-icon canvas. Only
     the middle 72dp of that canvas survives a round mask, so the group below
     scales the 32-unit mark to 70dp and centres it: 32 x 2.1875 = 70, and
     (108 - 70) / 2 = 19. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="2.1875"
        android:scaleY="2.1875"
        android:translateX="19"
        android:translateY="19">

        <!-- orbit: the footprint the platform travels -->
        <path
            android:pathData="M3,16 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0"
            android:strokeColor="#2b5f8f"
            android:strokeWidth="1.8"
            android:strokeAlpha="0.32" />

        <!-- scan: broken at the top, where the downlink passes through -->
        <path
            android:pathData="M20.3,8.55 A8.6,8.6 0 1 1 11.7,8.55"
            android:strokeColor="#4a7a29"
            android:strokeWidth="2.2"
            android:strokeAlpha="0.9" />

        <!-- core: the point on the ground being measured -->
        <path
            android:pathData="M12.2,16 a3.8,3.8 0 1,0 7.6,0 a3.8,3.8 0 1,0 -7.6,0"
            android:fillColor="#2b5f8f" />

        <!-- the platform itself, sitting on its orbit -->
        <path
            android:pathData="M13.6,3 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0"
            android:fillColor="#8a6a14" />
    </group>
</vector>
