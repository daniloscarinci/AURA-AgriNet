# The web app still has nothing to ignore. The Android wrapper in android/ does:
# Gradle writes build output, and local.properties names an SDK path that belongs
# to one machine and no other.
android/.gradle/
android/build/
android/app/build/
android/local.properties

# The APK itself, which every assemble drops into dist/. Machine-produced, 2.4 MB,
# and one command away at any time — this repository carries the project that
# builds the package, never the package.
/dist/
*.apk
